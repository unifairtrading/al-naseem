rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAlNaseemAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['super_admin', 'staff_admin'];
    }

    match /users/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /siteModules/{moduleId} {
      allow get: if moduleId == 'hotels';
      allow list: if false;
      allow create, update: if moduleId == 'hotels' && isAlNaseemAdmin();
      allow delete: if false;
    }

    // Public visitors may submit enquiries; only signed-in Al Naseem admins can view or update them.
    match /enquiries/{enquiryId} {
      allow create: if request.auth == null
        && request.resource.data.keys().hasOnly(['name', 'phone', 'interest', 'message', 'status', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string && request.resource.data.phone.size() > 0 && request.resource.data.phone.size() <= 40
        && request.resource.data.interest is string && request.resource.data.interest.size() <= 80
        && request.resource.data.message is string && request.resource.data.message.size() <= 1500
        && request.resource.data.status == 'new';
      allow read: if isAlNaseemAdmin();
      allow update: if isAlNaseemAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'updatedBy'])
        && request.resource.data.status in ['new', 'contacted', 'closed'];
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}