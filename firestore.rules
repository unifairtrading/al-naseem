rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAlNaseemAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['super_admin', 'staff_admin'];
    }

    // Each signed-in user can read only their own role profile.
    // Role documents cannot be created, changed or deleted from the website.
    match /users/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    // The public website can read this single module document.
    // Only an authorised Super Admin or Staff Admin can create or change it.
    match /siteModules/{moduleId} {
      allow get: if moduleId == 'hotels';
      allow list: if false;
      allow create, update: if moduleId == 'hotels' && isAlNaseemAdmin();
      allow delete: if false;
    }

    // All other data stays closed until its feature is implemented.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}