rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // An authenticated user may read only their own role profile.
    // No browser/client account can create, edit, or promote role documents.
    match /users/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    // All business collections remain closed until feature-specific rules
    // and matching application workflows are implemented and tested.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
