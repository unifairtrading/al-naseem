rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }

    function isAlNaseemAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
          || (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staff_admin'
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true
          )
        );
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow list: if isSuperAdmin();

      // Only a Super Admin can create a staff profile. The browser cannot grant Super Admin.
      allow create: if isSuperAdmin()
        && request.resource.data.keys().hasAll(['displayName', 'email', 'role', 'active', 'createdAt', 'createdBy'])
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'role', 'active', 'createdAt', 'createdBy'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 120
        && request.resource.data.role == 'staff_admin'
        && request.resource.data.active == true
        && request.resource.data.createdBy == request.auth.uid;

      // Super Admin can only edit staff profile details/access state, never change roles.
      allow update: if isSuperAdmin()
        && resource.data.role == 'staff_admin'
        && request.resource.data.role == 'staff_admin'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'active', 'updatedAt', 'updatedBy'])
        && request.resource.data.active is bool
        && request.resource.data.updatedBy == request.auth.uid;

      allow delete: if false;
    }

    match /siteModules/{moduleId} {
      // Public visitors can read the currently published hotel module. Other business modules
      // remain private until their public read requirements are explicitly defined.
      allow get: if moduleId in ['hotels', 'umrahPackages'] || isAlNaseemAdmin();
      allow list: if false;
      // Every active Staff Admin and the Super Admin can manage all business content modules.
      // User roles and system-security collections remain Super Admin-only above.
      allow create, update: if isAlNaseemAdmin();
      allow delete: if false;
    }

    // Public visitors may submit enquiries; only active Al Naseem admins can view or update them.
    match /enquiries/{enquiryId} {
      allow create: if request.auth == null
        && request.resource.data.keys().hasOnly(['name', 'phone', 'interest', 'message', 'status', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string && request.resource.data.phone.size() > 0 && request.resource.data.phone.size() <= 40
        && request.resource.data.interest is string && request.resource.data.interest.size() <= 80
        && request.resource.data.message is string && request.resource.data.message.size() <= 1500
        && request.resource.data.status == 'new';
      allow read: if isAlNaseemAdmin();
      allow update: if isAlNaseemAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'updatedBy'])
        && request.resource.data.status in ['new', 'contacted', 'closed'];
      allow delete: if isAlNaseemAdmin();
    }

    // Append-only activity trail. Active Staff Admins can record their own business changes;
    // only the Super Admin can read the log and manage access/security activity.
    match /auditLogs/{logId} {
      allow get, list: if isSuperAdmin();
      allow create: if isAlNaseemAdmin()
        && request.resource.data.keys().hasAll(['action', 'targetUid', 'targetEmail', 'details', 'actorUid', 'actorEmail', 'createdAt'])
        && request.resource.data.keys().hasOnly(['action', 'moduleId', 'targetUid', 'targetEmail', 'details', 'actorUid', 'actorEmail', 'createdAt'])
        && request.resource.data.action is string
        && request.resource.data.targetUid is string
        && request.resource.data.targetEmail is string
        && request.resource.data.details is string
        && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}